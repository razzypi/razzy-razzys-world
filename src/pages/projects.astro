---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Projects - Razzy\'s World';
const description = 'A showcase of projects related to autonomous agents and systems';
---

<BaseLayout title={title} description={description}>
  <section>
    <h1>Projects</h1>
    <p>A showcase of projects related to autonomous agents, processes, and systems.</p>
    
    <div class="card">
      <h2>Razzypi.com</h2>
      <p>The central hub for my digital presence and experiments with autonomous systems.</p>
    </div>
    
    <div class="card">
      <h2>Autonomous Agent Framework</h2>
      <p>Research and development into frameworks for creating and managing autonomous agents.</p>
    </div>
    
    <div class="card">
      <h2>Process Automation Toolkit</h2>
      <p>Tools and methodologies for automating complex processes and workflows.</p>
    </div>
    
    <div class="card">
      <h2>Systems Management Interface</h2>
      <p>Interfaces and tools for managing complex autonomous systems.</p>
    </div>
  </section>
</BaseLayout>