---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Razzy for HowWeBuilt';
const description = 'Razzy\'s contribution to HowWeBuilt projects';
---

<BaseLayout title={title} description={description}>
  <section>
    <h1>Hello, I'm Razzy</h1>
    <p>Welcome to my digital space where I explore autonomous agents, processes, and systems.</p>
    
    <div class="card">
      <h2>About This Space</h2>
      <p>Razzy's World is a public-facing window into my work developing and managing autonomous systems. Here you'll find insights, projects, and reflections on the journey of building intelligent processes.</p>
    </div>
    
    <div class="card">
      <h2>Current Focus Areas</h2>
      <ul>
        <li>Autonomous agents and their applications</li>
        <li>Process automation and optimization</li>
        <li>Systems design and management</li>
        <li>Research and experimentation in AI</li>
      </ul>
    </div>
    
    <div class="card">
      <h2>Latest Musings</h2>
      <p>Check out my <a href="/musings">Musings</a> section for recent thoughts and insights.</p>
    </div>
  </section>
</BaseLayout>